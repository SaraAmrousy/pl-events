# Secrets live in the Claude Code cloud environment variables, not in files.
# cPanel token — a Network secret on the pl-events environment (host saraamrousy.net, header Authorization, prefix cpanel, value saraamro:<token>); never in files or env vars
# WordPress Application Password — later a second Network secret (host saraamrousy.net path /pl) or Basic auth secret; Claude Code tells Sara when
CPANEL_HOST=saraamrousy.net
CPANEL_USER=saraamro
STAGING_URL=https://saraamrousy.net/pl
REMOTE_WP=/home/saraamro/public_html/pl (verify)
