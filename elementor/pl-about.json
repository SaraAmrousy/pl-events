     "isInner": false,
     "settings": {
      "shortcode": "[pl_section class=\"\" style=\"padding:88px 0 72px\" wrap_style=\"display:flex;flex-direction:column;gap:36px\"]\n<span class=\"lab mut\">About PL Events</span><h1 class=\"h1 h1xl focus-set\">From <span class=\"hl-city\">Alexandria</span> to [pl_stats layout=\"number\" field=\"countries\"] countries.</h1>\n<div style=\"display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:32px\" class=\"ab-int\"><p class=\"lead\" style=\"grid-column:span 6\">PL Events plans and runs medical congresses for scientific societies, from a head office in Alexandria and a regional office in Dubai. Most of our work is ophthalmology; vascular, lymphology and nephrology are growing.</p><p class=\"mut\" style=\"grid-column:8 / span 5;font-size:17px\">One team handles the science, the sponsors, the stage and the travel — and every congress since [pl_stats field=\"since_long\"] is on this site, with its date, city and registration.</p></div>\n<figure style=\"margin:0\">[pl_media src=\"assets/hall-wide.jpg\" alt=\"Delegates seated in a congress hall set up by PL Events\" class=\"photo rack\" style=\"height:420px;border-radius:10px;width:100%;object-fit:cover\"]<figcaption class=\"lab mut\" style=\"margin-top:10px\">From PL’s portfolio</figcaption></figure>\n[/pl_section]"
     },
