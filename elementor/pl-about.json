     "settings": {
      "shortcode": "[pl_section class=\"sec\" style=\"padding:104px 0 112px;position:relative;overflow:hidden;border-top:1.5px solid var(--line)\" wrap=\"0\"]\n<div aria-hidden=\"true\" class=\"out pl-out d-only\" style=\"position:absolute;right:40px;top:50%;transform:translateY(-50%);font-size:340px;line-height:.8;-webkit-text-stroke-color:#D9D5CC\">PL</div>\n<div class=\"wrap\" style=\"position:relative;display:flex;flex-direction:column;gap:22px\"><h2 class=\"h2 h2xl h2xxl\">Two cities. <span class=\"em\">One team.</span></h2><p class=\"mut\" style=\"font-size:18px;max-width:560px\">Tell us about your congress — the Alexandria or Dubai team answers.</p><div class=\"row\"><a href=\"[pl_url to=\"contact\" topic=\"proposal\"]\" class=\"btn bp\">Request a proposal</a>[pl_company field=\"portfolio_link\" class=\"btn bs\" label=\"Download our portfolio\"]</div></div>\n[/pl_section]"
